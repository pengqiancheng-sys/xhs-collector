{
  "manifest_version": 3,
  "name": "前程-灵感素材库",
  "version": "4.2.2",
  "description": "把网页上的标题、正文、图片整理进你的飞书多维表格。支持自定义字段映射、自动表结构探测与多表格切换。",
  "permissions": [
    "activeTab",
    "alarms",
    "contextMenus",
    "scripting",
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.xiaohongshu.com/*",
    "https://www.rednote.com/*",
    "https://*.xhscdn.com/*",
    "https://*.rednotecdn.com/*",
    "https://www.youtube.com/*",
    "https://open.feishu.cn/*",
    "https://accounts.feishu.cn/*",
    "https://accounts.larksuite.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.xiaohongshu.com/*",
        "https://www.rednote.com/*"
      ],
      "js": [
        "vendor/md5.min.js",
        "xhs-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://open.feishu.cn/*"
      ],
      "js": [
        "feishu-bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "page-observer.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page-bridge.js",
        "settings.html",
        "settings.js",
        "settings.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "action": {
    "default_title": "前程-灵感素材库",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "settings.html"
}
